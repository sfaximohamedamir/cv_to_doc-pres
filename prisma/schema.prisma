// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily for your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Représente un CV traité par l'agent
model CvRecord {
  id            String   @id @default(cuid())
  /// Nom du fichier original téléversé
  originalName  String
  /// Type MIME du fichier source (application/pdf, image/png, ...)
  sourceType    String
  /// Format de sortie choisi par l'utilisateur (word | powerpoint)
  outputFormat  String
  /// Nom du fichier généré (word ou powerpoint)
  outputName    String  ?
  /// Statut du traitement (pending | extracting | converting | scoring | done | error)
  status        String   @default("pending")
  /// Message d'erreur éventuel
  errorMessage  String?
  /// Texte brut extrait du CV
  extractedText String?
  /// Données structurées du CV au format JSON
  structuredData String?
  /// Score global attribué au CV (0-100)
  score         Int?
  /// Détail du score au format JSON (catégories + commentaire)
  scoreDetails  String?
  /// Chemin relatif du fichier généré dans /download
  filePath      String?
  /// Taille du fichier source en octets
  fileSize      Int
  /// Langue détectée du CV (fr, en, ...)
  language      String?
  /// Modèle NVIDIA utilisé pour l'extraction
  extractionModel String?
  /// Modèle NVIDIA utilisé pour le scoring
  scoringModel  String?
  /// Durée du traitement en millisecondes
  durationMs    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
